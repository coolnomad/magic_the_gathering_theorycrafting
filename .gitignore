# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
.venv/
venv/

# Claude Code logging-hook local dedup state (not part of the record)
.claude/hooks/.last_assistant_uuid

# Phase 3 task packets + shared context are regenerable from Phase 1/2 outputs
# via `hobkg build-tasks` (the model OUTPUTS under data/llm/extractions,
# data/llm/critiques, and data/review/llm_* ARE kept).
data/llm/tasks/
data/llm/shared_context.json
data/llm/tasks_index.jsonl

# Per-machine Claude Code permission allowlist (absolute Windows paths; not portable)
.claude/settings.local.json

# Compact runtime state is committed on purpose: audit/*.md, the executor
# transcripts and artifacts.db are the record of what ran. This matches the
# convention in adaptive_orchestrator and control_plane, which track all three.
# Only the SQLite sidecars are ignored.
audit/artifacts.db-journal
audit/artifacts.db-wal
audit/artifacts.db-shm

# 17Lands public game-data snapshot: 16MB gzipped, 985 columns, 241727 game rows.
# Six times larger than any other tracked source and the only binary one. It is a
# public download, so provenance (url + sha256 + bytes) is recorded in
# data/raw/source_manifest.json instead and the file is fetched, not versioned.
data/raw/game_data_public.*.csv.gz

# Derived modeling artifacts: ~13MB of parquet/npy/csv, all regenerable from
# data/raw + scripts/. Byte-level reproducibility is asserted through
# data/processed/MANIFEST.sha256 (tracked), the same way data/graph_global is
# pinned by frozen_manifest.json. The blobs themselves stay out of history.
# (must exclude the CONTENTS, not the directory -- git cannot re-include a file
# whose parent directory is itself excluded)
data/processed/*
!data/processed/MANIFEST.sha256

# Same rule for the quarantined copies now sitting in attic/ (see that
# directory's README). The manifest stays tracked so the discarded state is
# still identifiable; the blobs it names do not enter history.
attic/haiku-2026-09-07/data_processed/*
!attic/haiku-2026-09-07/data_processed/MANIFEST.sha256

# Trained model binaries — regenerable from a frozen split, wherever they live
*.xgb

# Card 009's estimator writes, per model, a predictions parquet, a model
# artifact, and a run-record json. The blobs are regenerable from the frozen
# split plus a representation matrix and stay out of history; the run record is
# NOT a blob -- it carries the split SHA256, the seed and the chosen
# hyperparameters, and is the only thing that makes a reported fit auditable
# after the fact. Track it, the same way MANIFEST.sha256 is tracked against the
# parquets it pins.
data/runs/*
!data/runs/*.json

# Runtime signal files written by tools/review_commit_watch.ps1 and consumed by
# tools/wait_review_ready.ps1 -- IPC scratch, not part of the record
docs/review_events/
# audit/executor_output/*.output.txt is the raw JSONL transcript per Compact
# session -- 300KB-1MB each on this project. Tracking them puts the entire
# prior transcript into every subsequent review's diff and blows the reviewer's
# 200k-token context budget (measured 2026-09-03, ports-v1 iter2). The audit
# record lives in audit/*.md (small, tracked); the transcripts stay on disk.
audit/executor_output/
