# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
.venv/
venv/

# Claude Code logging-hook local dedup state (not part of the record)
.claude/hooks/.last_assistant_uuid

# Phase 3 task packets + shared context are regenerable from Phase 1/2 outputs
# via `hobkg build-tasks` (the model OUTPUTS under data/llm/extractions,
# data/llm/critiques, and data/review/llm_* ARE kept).
data/llm/tasks/
data/llm/shared_context.json
data/llm/tasks_index.jsonl

# Per-machine Claude Code permission allowlist (absolute Windows paths; not portable)
.claude/settings.local.json

# Compact runtime state is committed on purpose: audit/*.md, the executor
# transcripts and artifacts.db are the record of what ran. This matches the
# convention in adaptive_orchestrator and control_plane, which track all three.
# Only the SQLite sidecars are ignored.
audit/artifacts.db-journal
audit/artifacts.db-wal
audit/artifacts.db-shm

# Runtime signal files written by tools/review_commit_watch.ps1 and consumed by
# tools/wait_review_ready.ps1 -- IPC scratch, not part of the record
docs/review_events/
