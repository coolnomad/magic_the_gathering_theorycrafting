# Hash manifest for the card-004, card-005 and card-006 modeling artifacts.
#
# The parquet/csv blobs are gitignored and regenerable from data/raw via
#   python -m deckbench.table && python -m deckbench.identity && \
#   python -m deckbench.skill && python -m deckbench.split
# This manifest is tracked so a rebuild is checked byte-for-byte. Paths
# are repository-root-relative; verify from the repository root with:
#   sha256sum -c data/processed/MANIFEST.sha256
#
d9b4f5c2dbec67d9feeaca900a958bfbf5560f8e43df5dab6be08c42d4998750 *data/processed/model_table.parquet
2cf659d1cb154c2482655a72ed6085f3554968276b8bb8f48996159f01885c7c *data/processed/deck_identity.parquet
8967247542e54ac258b3f38c72887ae6425e5a870d13706a093262d966ba34b9 *data/processed/card_identity_manifest.csv
4ac7ee8e5fe4551dc5b70c46df623ea69c487ef96b8c9f5ddb730ee5626889bc *data/processed/skill_features.parquet
ad7f8596f5e71c0aa4ce0959c239ef863e72977feadcb7a53d2a5ab0bd34cad4 *data/processed/model_split.parquet
