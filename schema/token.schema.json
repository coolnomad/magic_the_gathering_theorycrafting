{
  "$defs": {
    "ParsedTypeLine": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "title": "Raw",
          "type": "string"
        },
        "supertypes": {
          "items": {
            "type": "string"
          },
          "title": "Supertypes",
          "type": "array"
        },
        "types": {
          "items": {
            "type": "string"
          },
          "title": "Types",
          "type": "array"
        },
        "subtypes": {
          "items": {
            "type": "string"
          },
          "title": "Subtypes",
          "type": "array"
        }
      },
      "required": [
        "raw"
      ],
      "title": "ParsedTypeLine",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "A pointer back to the exact source of an asserted fact (principle #10).",
      "properties": {
        "card_id": {
          "title": "Card Id",
          "type": "string"
        },
        "face_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Face Id"
        },
        "source": {
          "description": "e.g. 'scryfall.keywords', 'scryfall.oracle_text', 'scryfall.all_parts'",
          "title": "Source",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "[start, end) char offsets into the cited text, when applicable",
          "title": "Span"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "verbatim matched substring, when applicable",
          "title": "Text"
        },
        "rule_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comprehensive Rules reference, when applicable",
          "title": "Rule Ref"
        }
      },
      "required": [
        "card_id",
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "type_line_raw": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Type Line Raw"
    },
    "type_line": {
      "anyOf": [
        {
          "$ref": "#/$defs/ParsedTypeLine"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "produced_by_card_ids": {
      "items": {
        "type": "string"
      },
      "title": "Produced By Card Ids",
      "type": "array"
    },
    "scryfall_related_ids": {
      "items": {
        "type": "string"
      },
      "title": "Scryfall Related Ids",
      "type": "array"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "Provenance",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "title": "TokenSpec",
  "type": "object"
}