{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "description": "A pointer back to the exact source of an asserted fact (principle #10).",
      "properties": {
        "card_id": {
          "title": "Card Id",
          "type": "string"
        },
        "face_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Face Id"
        },
        "source": {
          "description": "e.g. 'scryfall.keywords', 'scryfall.oracle_text', 'scryfall.all_parts'",
          "title": "Source",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "[start, end) char offsets into the cited text, when applicable",
          "title": "Span"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "verbatim matched substring, when applicable",
          "title": "Text"
        },
        "rule_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comprehensive Rules reference, when applicable",
          "title": "Rule Ref"
        }
      },
      "required": [
        "card_id",
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "edge_id": {
      "title": "Edge Id",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "target": {
      "title": "Target",
      "type": "string"
    },
    "predicate": {
      "enum": [
        "HAS_FACE",
        "HAS_ABILITY",
        "HAS_TYPE",
        "HAS_KEYWORD",
        "HAS_COST",
        "REQUIRES",
        "CONSUMES",
        "PRODUCES",
        "CAUSES",
        "TRIGGERS",
        "MODIFIES",
        "COUNTS",
        "CONTRIBUTES_TO",
        "SATISFIES",
        "ENABLES",
        "PREVENTS",
        "REPLACES",
        "MOVES_FROM",
        "MOVES_TO",
        "CREATES_OBJECT",
        "ADDS_COUNTER",
        "REMOVES_COUNTER",
        "SCALES_WITH",
        "PERSISTS_AS",
        "REFERENCES_RULE",
        "DERIVED_FROM"
      ],
      "title": "Predicate",
      "type": "string"
    },
    "polarity": {
      "default": "positive",
      "enum": [
        "positive",
        "negative"
      ],
      "title": "Polarity",
      "type": "string"
    },
    "scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope"
    },
    "timing": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timing"
    },
    "condition_ids": {
      "items": {
        "type": "string"
      },
      "title": "Condition Ids",
      "type": "array"
    },
    "quantity": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quantity"
    },
    "optional": {
      "default": false,
      "title": "Optional",
      "type": "boolean"
    },
    "certainty": {
      "default": "rules_explicit",
      "enum": [
        "rules_explicit",
        "high",
        "medium",
        "low"
      ],
      "title": "Certainty",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "Provenance",
      "type": "array"
    },
    "extractor": {
      "default": "rule_expansion",
      "enum": [
        "mechanical",
        "llm",
        "rule_expansion",
        "derived_projection"
      ],
      "title": "Extractor",
      "type": "string"
    },
    "review_status": {
      "default": "accepted",
      "enum": [
        "unreviewed",
        "accepted",
        "rejected"
      ],
      "title": "Review Status",
      "type": "string"
    }
  },
  "required": [
    "edge_id",
    "source",
    "target",
    "predicate"
  ],
  "title": "Edge",
  "type": "object"
}