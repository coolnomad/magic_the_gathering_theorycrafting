{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "description": "A pointer back to the exact source of an asserted fact (principle #10).",
      "properties": {
        "card_id": {
          "title": "Card Id",
          "type": "string"
        },
        "face_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Face Id"
        },
        "source": {
          "description": "e.g. 'scryfall.keywords', 'scryfall.oracle_text', 'scryfall.all_parts'",
          "title": "Source",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "[start, end) char offsets into the cited text, when applicable",
          "title": "Span"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "verbatim matched substring, when applicable",
          "title": "Text"
        },
        "rule_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comprehensive Rules reference, when applicable",
          "title": "Rule Ref"
        }
      },
      "required": [
        "card_id",
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "type": {
      "enum": [
        "Card",
        "CardFace",
        "Ability",
        "Operation",
        "Event",
        "Resource",
        "ObjectClass",
        "Zone",
        "CounterType",
        "State",
        "Gate",
        "Cost",
        "Effect",
        "Rule",
        "TokenSpec"
      ],
      "title": "Type",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "Provenance",
      "type": "array"
    }
  },
  "required": [
    "id",
    "type",
    "label"
  ],
  "title": "Node",
  "type": "object"
}